# ============ 要改的就这几行 ============

# 1) DeepSeek API key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# 2) 模型 (provider/model)
#    deepseek/deepseek-v4-flash   默认、便宜
#    deepseek/deepseek-v4-pro     思考模式,数学更稳
TUTOR_MODEL=deepseek/deepseek-v4-flash

# 3) 5 个账号,用户名:密码,逗号隔开
TUTOR_USERS=mk:mk,alan:alan,judy:judy,jacky:jacky,guest:guest

# 4) 部署到服务器时填你的域名(本地不用管)
TUTOR_DOMAIN=tutor.gagamin.com

# 5) Google 第三方登录(仅测试用,可选)。三项都留空 = 不启用,按钮不显示。
#    去 Google Cloud Console 建 OAuth Client(Web),回调填:
#      https://<你的域名>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 白名单:邮箱:app内账号名,逗号隔开。不在表里的 Google 账号登录后一律被拒。
GOOGLE_ALLOWLIST=you@gmail.com:jacky

# 6) 阿里云号码认证(短信验证码登录,仅测试用,可选)。key 留空 = 不启用。
#    开通「号码认证服务 → 短信认证服务」,用赠送签名+模板(免资质),建个只带
#    AliyunDypnsFullAccess 权限的 RAM 子账号拿 AccessKey。
ALIYUN_SMS_KEY_ID=
ALIYUN_SMS_KEY_SECRET=
ALIYUN_SMS_SIGN=恒创联众
ALIYUN_SMS_TEMPLATE=100001
# 白名单:手机号:app内账号名,逗号隔开。只有表里的号才发码、才放行。
SMS_ALLOWLIST=13800000000:jacky

# ============ 一般不用动 ============
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
MAX_CONCURRENCY=2
IDLE_TIMEOUT_MS=600000
